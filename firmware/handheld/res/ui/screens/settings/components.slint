import { Backend } from "../../common.slint";
import { ListView, ListContainer } from "../../components/list_view.slint";
import { SettingType, SettingValue, SettingEntry, SettingDatetime } from "types.slint";
import { DatetimePicker } from "datetime.slint";
import { ListBox } from "list_box.slint";
import { Icons } from "../../icons.slint";

component SettingsListViewItem {
    in property <SettingEntry> item;
    in property <bool> focused;
    in property <bool> selected;
    in property <int> index;
    in property <SettingDatetime> datetime-draft;
    in property <int> datetime-part: 0;

    Rectangle {
        width: root.width;
        height: root.height;
        background: root.focused ? #bbb : transparent;
        border-color: black;
        border-width: root.selected ? 1px : 0px;
    }

    i-text := Text {
        x: 2px;
        height: 100%;
        text: root.item.name;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }

    // Checkbox
    if item.type == SettingType.checkbox: Rectangle {
        background: white;
        x: parent.width - self.width - 4px;
        width: self.height;
        height: parent.height - 4px;
        border-color: black;
        border-width: 1px;

        if item.value.bool-value: Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: gray;
        }
    }
    if item.type == SettingType.subpage: Image {
        x: parent.width - self.width - 4px;
        source: Icons.right-arrow;
        colorize: #666;
    }
    if item.type == SettingType.datetime: DatetimePicker {
        selected: root.selected;
        dt: root.selected ? root.datetime-draft : item.value.datetime-value;
        part: root.datetime-part;
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) * 50%;
    }
    if item.type == SettingType.list: ListBox {
        x: parent.width - self.width - 4px;
        index: item.value.int-value;
        choices: item.choices;
        selected: root.selected;
        on-changed => {
            Backend.settings-changed(index, { int-value: self.index });
        }
    }
}

component SettingsListViewBase inherits ListView {
    in property <[SettingEntry]> model;
    in property <bool> item-selected: false;
    in property <SettingDatetime> datetime-draft;
    in property <int> datetime-part: 0;
    num-items: model.length;

    for item[index] in root.model: child-items := SettingsListViewItem {
        index: index;
        item: item;
        height: 20px;
        focused: index == root.current-item;
        selected: (index == root.current-item) && root.item-selected;
        datetime-draft: root.datetime-draft;
        datetime-part: root.datetime-part;
    }
}

export component SettingsListView inherits FocusScope {
    in property <[SettingEntry]> model;
    in-out property <int> focus-item <=> i-list.current-item;
    in property <bool> wrap <=> i-list.wrap;

    private property <bool> item-selected: false;
    private property <int> datetime-part: 0;
    private property <SettingDatetime> datetime-draft;

    changed model => {
        item-selected = false;
    }

    function step-datetime(delta: int) {
        datetime-draft = Backend.datetime-add(datetime-draft, {
            year: datetime-part == 0 ? delta : 0,
            month: datetime-part == 1 ? delta : 0,
            day: datetime-part == 2 ? delta : 0,
            hour: datetime-part == 3 ? delta : 0,
            min: datetime-part == 4 ? delta : 0,
        });
    }

    function activate-item(entry: SettingEntry) {
        if (entry.type == SettingType.checkbox) {
            Backend.settings-changed(i-list.current-item, { bool-value: !entry.value.bool-value });
        } else if (entry.type == SettingType.subpage) {
            Backend.settings-changed(i-list.current-item, { });
        } else if (entry.type == SettingType.datetime) {
            datetime-part = 0;
            datetime-draft = entry.value.datetime-value;
            item-selected = true;
        } else {
            item-selected = true;
        }
    }

    function handle-datetime-key(event: KeyEvent) -> EventResult {
        if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
            datetime-part = clamp(datetime-part + (event.text == Key.RightArrow ? 1 : -1), 0, 4);
            return accept;
        }
        if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
            root.step-datetime(event.text == Key.UpArrow ? 1 : -1);
            return accept;
        }
        if (event.text == "a" && !event.repeat) {
            Backend.settings-changed(i-list.current-item, { datetime-value: root.datetime-draft });
            item-selected = false;
            return accept;
        }
        if (event.text == "b" && !event.repeat) {
            item-selected = false;
            return accept;
        }
        reject
    }

    ListContainer {
        width: 100%;
        height: 100%;
        viewport-y: i-list.viewport-y;
        viewport-height: i-list.viewport-height;
        visible-height: i-list.visible-height;

        i-list := SettingsListViewBase {
            model: root.model;
            item-selected: root.item-selected;
            datetime-draft: root.datetime-draft;
            datetime-part: root.datetime-part;
        }
    }

    key-pressed(event) => {
        if (!item-selected) {
            if (event.text == Key.UpArrow) {
                i-list.select-up();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                i-list.select-down();
                return accept;
            }
            if (event.text == "a" && !event.repeat) {
                if (i-list.has-selection()) {
                    root.activate-item(model[i-list.current-item]);
                }
                return accept;
            }
            return reject;
        }

        if (!i-list.has-selection()) {
            item-selected = false;
            return reject;
        }
        if (model[i-list.current-item].type == SettingType.datetime) {
            return root.handle-datetime-key(event);
        }
        if ((event.text == "a" || event.text == "b") && !event.repeat) {
            item-selected = false;
            root.focus();
            return accept;
        }
        reject
    }
}
