import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { Button } from "../components/button.slint";
import { CoreSettingList } from "cores/core_settings.slint";
import { CoreSettingType } from "cores/types.slint";

component SidebarMenu inherits VerticalLayout {
    callback on-selected(item: int);

    in property <[string]> items;
    in-out property <int> focused-item: 0;

    padding: 4px;
    spacing: 2px;
    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.repeat) {
                reject
            } else if (event.text == "a") {
                on-selected(focused-item);
                accept
            } else if (event.text == Key.UpArrow) {
                focused-item = max(0, focused-item - 1);
                accept
            } else if (event.text == Key.DownArrow) {
                focused-item = min(items.length - 1, focused-item + 1);
                accept
            } else {
                reject
            }
        }
    }

    for item[index] in items: Rectangle {
        min-width: i-text.preferred-width + 8px;
        height: i-text.preferred-height + 4px;
        border-width: focused-item == index ? 1px : 0px;
        border-color: black;

        i-text := Text {
            text: item;
            x: 4px;
            y: (parent.height - self.height) / 2;
            color: focused-item == index ? black : gray;
        }
    }
}


export component GameScreen inherits ScreenBase {
    private property <bool> menu-open: false;
    private property <bool> settings-open: false;
    forward-focus: i-focus-scope;

    // /** todo: dev remove */
    // width: 240px;
    // height: 160px;
    // background: magenta;
    // init => {
    //     menu-open = true;
    //     settings-open = true;
    //     // i-settings.focus();
    // }

    private property <bool> power-menu-open: Global.power-menu-open;
    private property <bool> core-is-loading: Backend.core-is-loading;

    changed power-menu-open => {
        if (self.power-menu-open) {
            if (!root.menu-open && !Backend.core-is-loading) {
                set-menu-open(true);
            }
        } else if (root.menu-open && !root.settings-open) {
            i-list.focus();
        }
    }

    changed core-is-loading => {
        if (!self.core-is-loading && Global.power-menu-open && !root.menu-open) {
            set-menu-open(true);
        }
    }

    protected function set-menu-open(open: bool) {
        Global.ui-status-bar = open;
        Backend.game-set-focused(!open);
        self.menu-open = open;
        if (menu-open) {
            i-list.focused-item = 0;
            if (!Global.power-menu-open) {
                i-list.focus();
            }
        } else {
            settings-open = false;
            i-focus-scope.focus();
        }
    }

    i-focus-scope := FocusScope {
        key-released(event) => {
            if event.text == "Home" && !Backend.core-is-loading {
                set-menu-open(!root.menu-open);
            }
            if event.text == "b" {
                if settings-open {
                    settings-open = false;
                    i-list.focus();
                } else {
                    set-menu-open(false);
                }
            }
            reject
        }

        i-menu := Rectangle {
            visible: menu-open && !Global.power-menu-open;
            background: #FFF;
            x: 0;
            width: i-list.min-width;
            height: 100%;

            i-list := SidebarMenu {
                alignment: start;
                items: ["Return", "Settings >", "Reset", "Exit Core"];
                on-selected(item) => {
                    if (item == 0) {
                        root.set-menu-open(false);
                    } else if (item == 1) {
                        Backend.game-settings-load();
                        root.settings-open = true;
                    } else if (item == 2) {
                        Backend.game-reset();
                        set-menu-open(false);
                    } else if (item == 3) {
                        Backend.game-exit();
                    }
                }
            }
        }

        if settings-open: Rectangle {
            visible: !Global.power-menu-open;
            background: #FFF;
            border-color: black;
            border-width: 1px;
            x: i-menu.width + 8px;
            y: 32px;
            width: root.width - self.x - 8px;
            height: root.height - 64px;

            CoreSettingList {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                init => {
                    self.focus();
                }
            }
        }

        if Backend.core-is-loading:  Rectangle {
            background: #FFF;
            border-color: black;
            border-width: 1px;
            width: i-loading-layout.min-width;
            height: i-loading-layout.min-height;

            i-loading-layout := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                i-text := Text {
                    horizontal-alignment: center;
                    text: "Loading...";
                }

                Rectangle {
                    background: black;
                    width: Backend.core-progress * i-text.min-width;
                    height: 2px;
                }
            }
        }
    }
}
