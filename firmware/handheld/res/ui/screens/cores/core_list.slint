import { Backend } from "../../common.slint";
import { ListView, ListContainer } from "../../components/list_view.slint";
import { ControlHint } from "../../components/control_hint.slint";
import { CoreListEntry } from "types.slint";

component CoreListItem inherits Rectangle {
    in property <CoreListEntry> core;
    in property <bool> focused;

    background: root.focused ? #bbb : transparent;

    HorizontalLayout {
        padding: 2px;
        height: 100%;

        Text {
            text: core.core-name;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
            min-width: 160px;
            horizontal-stretch: 2.0;
        }

        Text {
            text: core.core-author;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            color: #666;
            min-width: 80px;
            horizontal-stretch: 1.0;
        }
    }
}

component CoreListBase inherits ListView {
    in property <[CoreListEntry]> model;
    num-items: model.length;

    for item[index] in root.model: CoreListItem {
        height: 20px;
        core: item;
        focused: index == root.current-item;
    }
}

export component CoreList {
    in property <[CoreListEntry]> cores;
    in property <bool> is-loading: cores.length == 0;

    callback on-cancel();
    callback on-core-selected(/* selected-item */ int);

    forward-focus: i-focus-scope;

    // Loading box
    if is-loading: Rectangle {
        background: #FFF;
        border-color: black;
        border-width: 1px;
        width: i-layout.min-width;
        height: i-layout.min-height;

        i-layout := VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text {
                horizontal-alignment: center;
                text: "Loading...";
            }
        }
    }

    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (is-loading) {
                return reject;
            } else if (event.text == Key.UpArrow) {
                i-list.select-up();
                return accept;
            } else if (event.text == Key.DownArrow) {
                i-list.select-down();
                return accept;
            } else if (event.text == "a" && !event.repeat && i-list.has-selection()) {
                on-core-selected(i-list.current-item);
                return accept;
            } else if (event.text == "b") {
                on-cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 2px;

            ListContainer {
                viewport-y: i-list.viewport-y;
                viewport-height: i-list.viewport-height;
                visible-height: i-list.visible-height;

                i-list := CoreListBase {
                    model: root.cores;
                    wrap: true;
                    current-item <=> Backend.core-list-index;
                }
            }

            HorizontalLayout {
                alignment: space-between;

                ControlHint {
                    label: "Back";
                    button: "b";
                }

                ControlHint {
                    label: "Select";
                    button: "a";
                }
            }
        }
    }
}
