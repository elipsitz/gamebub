import { Backend } from "../../common.slint";
import { ListView, ListContainer } from "../../components/list_view.slint";
import { SettingType, SettingValue, SettingEntry } from "types.slint";
import { DatetimePicker } from "datetime.slint";
import { ListBox } from "list_box.slint";
import { Icons } from "../../icons.slint";

component SettingsListViewItem {
    in property <SettingEntry> item;
    in property <bool> focused;
    in property <bool> selected;
    in property <int> index;

    Rectangle {
        width: root.width;
        height: root.height;
        background: root.focused ? #bbb : transparent;
        border-color: black;
        border-width: root.selected ? 1px : 0px;
    }

    i-text := Text {
        x: 2px;
        height: 100%;
        text: root.item.name;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }

    // Checkbox
    if item.type == SettingType.checkbox: Rectangle {
        background: white;
        x: parent.width - self.width - 4px;
        width: self.height;
        height: parent.height - 4px;
        border-color: black;
        border-width: 1px;

        if item.value.bool-value: Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: gray;
        }
    }
    if item.type == SettingType.subpage: Image {
        x: parent.width - self.width - 4px;
        source: Icons.right-arrow;
        colorize: #666;
    }
    if item.type == SettingType.datetime: DatetimePicker {
        selected: root.selected;
        dt: item.value.datetime-value;
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) * 50%;
        on-changed(delta) => {
            Backend.settings-changed(index, { datetime-value: delta });
        }
    }
    if item.type == SettingType.list: ListBox {
        x: parent.width - self.width - 4px;
        index: item.value.int-value;
        choices: item.choices;
        selected: root.selected;
        on-changed => {
            Backend.settings-changed(index, { int-value: self.index });
        }
    }
}

component SettingsListViewBase inherits ListView {
    in property <[SettingEntry]> model;
    in property <bool> item-selected: false;
    num-items: model.length;

    for item[index] in root.model: child-items := SettingsListViewItem {
        index: index;
        item: item;
        height: 20px;
        focused: index == root.current-item;
        selected: (index == root.current-item) && root.item-selected;
    }
}

export component SettingsListView inherits FocusScope {
    in property <[SettingEntry]> model;
    in-out property <int> focus-item <=> i-list.current-item;
    in property <bool> wrap <=> i-list.wrap;

    private property <bool> item-selected: false;

    changed model => {
        item-selected = false;
    }

    function activate() {
        if (item-selected) {
            item-selected = false;
            root.focus();
            return;
        }
        if (!i-list.has-selection()) {
            return;
        }
        if (model[i-list.current-item].type == SettingType.checkbox) {
            Backend.settings-changed(i-list.current-item, { bool-value: !model[i-list.current-item].value.bool-value });
        } else if (model[i-list.current-item].type == SettingType.subpage) {
            Backend.settings-changed(i-list.current-item, { });
        } else {
            item-selected = true;
        }
    }

    ListContainer {
        width: 100%;
        height: 100%;
        viewport-y: i-list.viewport-y;
        viewport-height: i-list.viewport-height;
        visible-height: i-list.visible-height;

        i-list := SettingsListViewBase {
            model: root.model;
            item-selected: root.item-selected;
        }
    }

    key-pressed(event) => {
        if (!item-selected) {
            if (event.text == Key.UpArrow) {
                i-list.select-up();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                i-list.select-down();
                return accept;
            }
        }
        if (event.text == "a" && !event.repeat) {
            root.activate();
            return accept;
        }
        if (event.text == "b" && item-selected && !event.repeat) {
            item-selected = false;
            root.focus();
            return accept;
        }
        reject
    }
}
