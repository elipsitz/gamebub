import { ListContainer } from "list_view.slint";

// Vertically scrollable container, where child elements cannot be interacted with
export component ScrollView inherits FocusScope {
    in property <length> scroll-rate: 4px;
    out property <bool> is-scroll-at-end: area.viewport-y == (area.height - area.viewport-height);

    function scroll(y: length) {
        area.viewport-y = clamp(
            area.viewport-y - y,
            area.height - area.viewport-height,
            0,
        );
    }

    ListContainer {
        width: 100%;
        height: 100%;
        viewport-y: area.viewport-y;
        viewport-height: area.viewport-height;
        visible-height: area.height;

        area := Flickable {
            width: 100%;
            height: 100%;

            @children
        }
    }

    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            scroll(-scroll-rate);
            return accept;
        } else if (event.text == Key.DownArrow) {
            scroll(scroll-rate);
            return accept;
        }
        reject
    }
}
