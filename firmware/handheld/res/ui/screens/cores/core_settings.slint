import { Backend } from "../../common.slint";
import { ListView } from "../../components/list_view.slint";
import { ChoicePopup } from "../../components/choice_popup.slint";
import { CoreSetting, CoreSettingType } from "types.slint";

component CoreSettingListItem {
    in property <CoreSetting> item;
    in property <bool> selected;

    Rectangle {
        width: root.width;
        height: root.height;
        border-width: 1px;
        border-color: selected ? black : transparent;
    }

    Text {
        x: 4px;
        height: 100%;
        max-width: parent.width - 8px;
        text: item.label;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }

    if item.type == CoreSettingType.checkbox: Rectangle {
        background: white;
        x: parent.width - self.width - 4px;
        width: self.height;
        height: parent.height - 4px;
        border-color: black;
        border-width: 1px;

        Rectangle {
            visible: item.value != 0;
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: gray;
        }
    }

    if item.type == CoreSettingType.list: Text {
        x: parent.width - self.width - 4px;
        height: 100%;
        vertical-alignment: center;
        text: (item.value >= 0 && item.value < item.choices.length) ? item.choices[item.value] : "";
    }
}

component CoreSettingListBase inherits ListView {
    in property <[CoreSetting]> model: Backend.core-settings;
    num-items: model.length;
    current-item: 0;

    for item[index] in root.model: CoreSettingListItem {
        height: 20px;
        item: item;
        selected: index == root.current-item;
    }
}

export component CoreSettingList inherits FocusScope {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-width: 100%;
    preferred-height: 100%;

    function set-current-value(entry: CoreSetting, val: int) {
        Backend.core-settings[i-list.current-item] = {
            id: entry.id,
            label: entry.label,
            type: entry.type,
            value: val,
            choices: entry.choices,
        };
        Backend.game-settings-set(entry.id, val);
    }

    function activate-item(entry: CoreSetting) {
        if (entry.type == CoreSettingType.action) {
            Backend.game-settings-set(entry.id, entry.value);
        } else if (entry.type == CoreSettingType.checkbox) {
            root.set-current-value(entry, (entry.value == 0) ? 1 : 0);
        } else if (entry.type == CoreSettingType.list && entry.choices.length > 0) {
            i-choice-popup.show();
        }
    }

    i-choice-popup := ChoicePopup {
        width: parent.width;
        height: parent.height;
        choices: i-list.has-selection() ? i-list.model[i-list.current-item].choices : [];
        initial-item: i-list.has-selection() ? i-list.model[i-list.current-item].value : 0;
        anchor-y: i-list.current-item * 20px + i-list.viewport-y;

        selected(index) => {
            if (i-list.has-selection()) {
                root.set-current-value(i-list.model[i-list.current-item], index);
            }
        }
    }

    i-list := CoreSettingListBase {
        width: 100%;
        height: 100%;
    }

    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            i-list.select-up();
            return accept;
        }
        if (event.text == Key.DownArrow) {
            i-list.select-down();
            return accept;
        }
        if (event.text == "a" && !event.repeat && i-list.has-selection()) {
            root.activate-item(i-list.model[i-list.current-item]);
            return accept;
        }
        reject
    }
}
