export enum CoreSubscreen {
    List,
    Detail,
    FileSelect,
    Loading,
    Error,
}

export struct CoreListEntry {
    core-id: string,
    core-name: string,
    core-author: string,
}

export enum CoreSettingType {
    action,
    checkbox,
    list,
}

export struct CoreSetting {
    id: int,
    label: string,
    type: CoreSettingType,
    value: int,
    choices: [string],
}
